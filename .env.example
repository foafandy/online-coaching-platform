# ---------------------------------------------------------------------------
# Coach Fouad — environment configuration
# Copy this file to `.env.local` (development) or set the same variables on
# your host. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public base URL used in password-reset emails.
APP_URL=http://localhost:3100

# Seeded coach account. Set these BEFORE the first start, otherwise the
# defaults below are used and printed to the server log.
ADMIN_EMAIL=admin@coachfouad.com
ADMIN_PASSWORD=CoachFouad2026!

# Optional: absolute path to the SQLite file (defaults to storage/coach-fouad.db).
# DATABASE_PATH=/var/data/coach-fouad.db

# Optional: transactional email for password resets (https://resend.com).
# Without a key, reset links are printed to the server console.
# RESEND_API_KEY=
# MAIL_FROM="Coach Fouad <coaching@yourdomain.com>"
